# App
APP_ENV=development
APP_NAME=customer-support-rag-triage-agent
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:7860
DEMO_MODE=true
MOCK_LLM_MODE=true
BOOTSTRAP_DEMO_DATA=true
DEMO_FIXTURE_PATH=data/demo/support_cases.json
ADMIN_API_KEY=
ALLOW_PUBLIC_INGEST=false
LOG_LEVEL=INFO

# Dataset
DATASET_PROVIDER=huggingface
HF_DATASET_NAME=mteb/banking77
HF_DATASET_CONFIG=default
HF_DATASET_SPLIT=train
DATASET_SAMPLE_SIZE=1000
CSV_DATASET_PATH=data/raw/support_dataset.csv
TEXT_FIELD=message
INTENT_FIELD=intent
RESPONSE_FIELD=response
SOURCE_FIELD=source

# Qdrant
QDRANT_MODE=local
QDRANT_PATH=.data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=support_tickets
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine
QDRANT_RECREATE_COLLECTION=false

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_MAX_CONTEXT_CHARS=4000

# Inference
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
LLM_RETRY_BACKOFF_SECONDS=0
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512

# Mock/local remains the default. External GenAI is activated only when
# DEMO_MODE=false, MOCK_LLM_MODE=false, and EXTERNAL_LLM_URL is configured.
EXTERNAL_LLM_URL=
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=general

# Cache
LLM_CACHE_ENABLED=true
LLM_CACHE_BACKEND=sqlite
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_TTL_SECONDS=86400

# Limits and safety
MAX_MESSAGE_CHARS=2000
MAX_TOP_K=10
MAX_INGEST_BATCH_SIZE=1000
ENABLE_SAFE_FALLBACK=true
RETURN_AGENT_TRACE=true
REQUEST_TIMEOUT_SECONDS=60

# In-memory rate limits (per process and client IP)
TRIAGE_RATE_LIMIT_REQUESTS=30
TRIAGE_RATE_LIMIT_WINDOW_SECONDS=3600
SEARCH_RATE_LIMIT_REQUESTS=60
SEARCH_RATE_LIMIT_WINDOW_SECONDS=3600
INGEST_RATE_LIMIT_REQUESTS=5
INGEST_RATE_LIMIT_WINDOW_SECONDS=3600

# Evaluation
EVAL_DATA_PATH=data/eval/eval_set.csv
EVAL_OUTPUT_PATH=reports/evaluation/results.json
