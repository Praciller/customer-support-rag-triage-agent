# App
APP_ENV=development
APP_NAME=customer-support-rag-triage-agent
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:7860
DEMO_MODE=true
MOCK_LLM_MODE=true
BOOTSTRAP_DEMO_DATA=true
DEMO_FIXTURE_PATH=data/demo/support_cases.json
ADMIN_API_KEY=
ALLOW_PUBLIC_INGEST=false
LOG_LEVEL=INFO

# Dataset
DATASET_PROVIDER=huggingface
HF_DATASET_NAME=mteb/banking77
HF_DATASET_CONFIG=default
HF_DATASET_SPLIT=train
DATASET_SAMPLE_SIZE=1000
CSV_DATASET_PATH=data/raw/support_dataset.csv
TEXT_FIELD=message
INTENT_FIELD=intent
RESPONSE_FIELD=response
SOURCE_FIELD=source

# Qdrant
QDRANT_MODE=local
QDRANT_PATH=.data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=support_tickets
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine
QDRANT_RECREATE_COLLECTION=false

# Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=true

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_MAX_CONTEXT_CHARS=4000

# LLM Provider Routing
LLM_PROVIDER_PRIORITY=gemini,groq,cerebras
LLM_DEFAULT_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512

# Gemini / Google AI Studio
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Groq
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant
GROQ_GENERATION_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_QUALITY_FALLBACK_MODEL=llama-3.3-70b-versatile

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b

# Task-specific model routing
INTENT_MODEL_PROVIDER=groq
INTENT_MODEL_NAME=llama-3.1-8b-instant
URGENCY_MODEL_PROVIDER=groq
URGENCY_MODEL_NAME=llama-3.1-8b-instant
RESPONSE_MODEL_PROVIDER=gemini
RESPONSE_MODEL_NAME=gemini-3.1-flash-lite
GROUNDING_MODEL_PROVIDER=gemini
GROUNDING_MODEL_NAME=gemini-3.1-flash-lite

# Cache
LLM_CACHE_ENABLED=true
LLM_CACHE_BACKEND=sqlite
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_TTL_SECONDS=86400

# Limits and safety
MAX_MESSAGE_CHARS=2000
MAX_TOP_K=10
MAX_INGEST_BATCH_SIZE=1000
ENABLE_SAFE_FALLBACK=true
RETURN_AGENT_TRACE=true
REQUEST_TIMEOUT_SECONDS=60

# In-memory rate limits (per process and client IP)
TRIAGE_RATE_LIMIT_REQUESTS=30
TRIAGE_RATE_LIMIT_WINDOW_SECONDS=3600
SEARCH_RATE_LIMIT_REQUESTS=60
SEARCH_RATE_LIMIT_WINDOW_SECONDS=3600
INGEST_RATE_LIMIT_REQUESTS=5
INGEST_RATE_LIMIT_WINDOW_SECONDS=3600

# Evaluation
EVAL_DATA_PATH=data/eval/eval_set.csv
EVAL_OUTPUT_PATH=reports/evaluation/results.json
